# style-editor 需要的環境變數範本。
# ---- Gemini API（日文校對用，必填）----
# 到 https://aistudio.google.com/apikey 用 Google 帳號登入免費申請
GEMINI_API_KEY=

# 使用的模型，預設 gemini-3.5-flash-lite（免費額度較大，見 README「節點與流量限制」）
GEMINI_MODEL=gemini-3.5-flash-lite

# 重寫模式（重排句子順序）專用的模型，留空就跟 GEMINI_MODEL 用同一個。
# 如果 flash-lite 的重寫效果不夠好，可以只讓重寫改用比較強的模型。
GEMINI_REWRITE_MODEL=

# 單次「開始 / 重新」最多打幾次 API（配合 Gemini 免費額度的 RPM 限制）
GEMINI_RPM_LIMIT=15

# 撞到 429（RPM 超過）時最多自動重試幾次
GEMINI_MAX_RETRIES=3

# ---- WordPress 資料庫（Local WP，必填）----
# 這些連線資訊要到 Local WP 的網站頁面 -> Database 分頁查看（每個網站的 PORT 不同）
DB_HOST=localhost
DB_PORT=10018
DB_NAME=local
DB_USER=root
DB_PASSWORD=root

# 資料表前綴，Local WP 預設是 wp_
DB_TABLE_PREFIX=wp_
